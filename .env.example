WORKSPACE=/workspace
COMFYUI_DIR=/workspace/ComfyUI
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_REF=v0.34.2
CLIPCACHED_REPO=https://github.com/Mu5hr00moO/ComfyUI-MiniMaxH3-CLIPCached.git
# Pinned, not master. CLAUDE.md fixes CLIPCached at f17ba8f, and a fresh build
# that takes whatever master is that day gets a different node: the 2026-09-19
# migration installed 507c1ec this way and had to be walked back by hand. The
# cache fingerprint depends on this code, so drifting it silently invalidates
# every cached entry the baseline was validated against.
CLIPCACHED_REF=f17ba8f369740a02a2138031517f853eb67b9d43
HF_REPO=Comfy-Org/MiniMax-H3
HF_REVISION=main
COMFY_HOST=0.0.0.0
COMFY_PORT=8188
COMFY_EXTRA_ARGS=
PIP_CACHE_DIR=/workspace/.cache/pip
HF_HOME=/workspace/.cache/huggingface
SKIP_MODELS=0
SKIP_WORKFLOWS=0
# HF_TOKENはここに保存せず shell で export すること
# Optional overrides used by the scripts (defaults shown):
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130   # install_comfyui.sh
# REQUIRE_CUDA=1                                            # install_comfyui.sh fails unless torch CUDA 13.x works
# PID_FILE=<project>/results/comfyui.pid  COMFY_LOG=<project>/results/logs/comfyui.log   # start/stop/status
# After the first successful HIT: CLIPCACHED_REF=<commit sha from results/environment_snapshot/clipcached_commit.txt>
